#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer SphereBuffer {
    vec4 spheres[]; // xyz -> center, w -> radius
};

layout(set = 0, binding = 1) uniform writeonly image2D outImage;

layout(push_constant) uniform PushConstants {
    vec3  playerPosition;
    vec3  playerRotation;
    vec3  cameraData;     // xy = resolution, z = fov
    float boundingRadius;
    uint  sphereCount;
} pc;


// Raymarching math
const int   MAX_STEPS   = 128;
const float HIT_EPSILON = 0.001;

float sphereSDF(vec3 p, vec4 s) {
    return length(p - s.xyz) - s.w;
}

const vec3 CELL = vec3(5.0); // rozmiar komórki powtarzania

vec3 repeat(vec3 p, vec3 c) {
    return p - c * round(p / c);   // komórka wycentrowana w 0, zakres [-c/2, c/2]
}

float sceneSDF(vec3 p) {
    vec3 q = repeat(p, CELL);
    float d = 1e20;
    for (uint i = 0; i < pc.sphereCount; i++)
        d = min(d, sphereSDF(q, spheres[i]));
    return d;
}


vec3 calcNormal(vec3 p) {
    const vec2 e = vec2(0.001, 0.0);
    return normalize(vec3(
        sceneSDF(p + e.xyy) - sceneSDF(p - e.xyy),
        sceneSDF(p + e.yxy) - sceneSDF(p - e.yxy),
        sceneSDF(p + e.yyx) - sceneSDF(p - e.yyx)));
}

mat3 cameraRotation(vec3 r) {
    float cp = cos(r.x), sp = sin(r.x);
    float cy = cos(r.y), sy = sin(r.y);
    float cr = cos(r.z), sr = sin(r.z);

    // GLSL mat3 constructors are column-major
    mat3 pitch = mat3(1.0, 0.0, 0.0,
                      0.0,  cp, -sp,
                      0.0,  sp,  cp);
    mat3 yaw   = mat3( cy, 0.0, -sy,
                      0.0, 1.0, 0.0,
                       sy, 0.0,  cy);
    mat3 roll  = mat3( cr, -sr, 0.0,
                       sr,  cr, 0.0,
                      0.0, 0.0, 1.0);

    return yaw * pitch * roll;
}

vec3 shade(vec3 p) {
    vec3 n = calcNormal(p);
    vec3 lightDir = normalize(vec3(0.6, 0.8, -0.4));
    float diffuse = max(dot(n, lightDir), 0.0);
    return vec3(0.8, 0.0, 0.2) * (0.15 + 0.85 * diffuse);
}


// Wcześniej robił to za Ciebie format *_SRGB, teraz robisz to ręcznie
vec3 linearToSrgb(vec3 c) {
    return mix(12.92 * c,
               1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055,
               step(0.0031308, c));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = imageSize(outImage);
    if (pixel.x >= size.x || pixel.y >= size.y)
        return; // wątki poza ekranem (rozdzielczość nie dzieli się przez 8)

    vec2  resolution = vec2(size);
    float fov        = pc.cameraData.z;

    vec2 fragCoord = vec2(pixel) + 0.5;          // odpowiednik gl_FragCoord
    vec2 uv = (fragCoord - 0.5 * resolution) / resolution.y;
    uv.y = -uv.y;                                // (0,0) obrazu to lewy górny róg

    float focalLength = 0.5 / tan(fov * 0.5);
    vec3 ro = pc.playerPosition;
    vec3 rd = cameraRotation(pc.playerRotation) * normalize(vec3(uv, focalLength));

    vec3 color = vec3(0.03);
    float t = 0.0;
    for (int step = 0; step < MAX_STEPS && t < pc.boundingRadius; step++) {
        vec3 p = ro + rd * t;
        float d = sceneSDF(p);
        if (d < HIT_EPSILON) { color = shade(p); break; }
        t += d;
    }

    imageStore(outImage, pixel, vec4(linearToSrgb(color), 1.0));
}
